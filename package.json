{
  "name": "ai-voice-studio",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "native:build": "cmake --build --preset native-debug",
    "native:build:release": "cmake --build --preset native-release",
    "native:configure": "cmake --preset native-debug",
    "native:configure:release": "cmake --preset native-release",
    "native:test": "ctest --preset native-debug",
    "native:test:release": "ctest --preset native-release",
    "test:doctor": "node --test tools/scripts/doctor.test.mjs",
    "format:check": "cargo fmt --all -- --check",
    "doctor": "node tools/scripts/doctor.mjs",
    "workspace:list": "pnpm --recursive list --depth -1"
  }
}
